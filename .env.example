# Template for local development secrets. Copy to .env (git-ignored) and fill in.
# NEVER commit real values (AGENTS.md §24).

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/onlinejudge
DB_USERNAME=onlinejudge
DB_PASSWORD=change-me

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=onlinejudge
RABBITMQ_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT signing secret (HS256, >= 32 bytes base64). Generate with:
# openssl rand -base64 48
JWT_SECRET=change-me-base64
